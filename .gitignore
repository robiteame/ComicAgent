# ============================================
# AI漫剧Agent - Global .gitignore
# ============================================

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python type checking
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---- Node / Electron ----
node_modules/
dist/
out/
release/
*.tgz

# Electron
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.exe
*.msi

# pnpm
pnpm-debug.yaml

# ---- Environment & Secrets ----
.env
.env.local
.env.*.local

# ---- Project Runtime Data ----
# Server output (generated images, audio, video)
output/
server/output/
# ChromaDB vector store
server/data/chromadb/
# LangGraph checkpoints
server/data/checkpoints/
# SQLite database
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Build Artifacts ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Misc ----
*.tmp
*.bak
*.cache
