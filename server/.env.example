# LLM 配置 (openai / mimo / seeddance)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Mimo (小米 MiMo, 通过硅基流动 SiliconFlow 调用)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.siliconflow.cn/v1
MIMO_MODEL=XiaomiMiMo/MiMo-7B-RL

# SeedDance (字节跳动, 通过火山引擎方舟平台调用)
SEEDDANCE_API_KEY=
SEEDDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDDANCE_MODEL=doubao-1.5-pro-32k

# 图像生成配置
IMAGE_PROVIDER=stability
STABILITY_API_KEY=sk-your-stability-key

# TTS 配置
TTS_PROVIDER=edge
TTS_DEFAULT_VOICE=zh-CN-XiaoyiNeural
